# Copy to .env and change every value marked CHANGE.
SMS_ENVIRONMENT=development
SMS_DATABASE_URL=postgresql+psycopg://sms_app:CHANGE@localhost:5432/sms
SMS_REDIS_URL=redis://localhost:6379/0
# 64+ random characters: python -c "import secrets; print(secrets.token_urlsafe(64))"
SMS_JWT_SECRET=CHANGE
SMS_CORS_ORIGINS=["http://localhost:5173"]
SMS_STORAGE_DIR=./storage
# console = log SMS instead of sending (development)
SMS_SMS_PROVIDER=console
SMS_SMS_API_URL=
SMS_SMS_API_KEY=
SMS_SMS_SENDER_ID=MFANO-SS
SMS_GEPG_ENABLED=false
SMS_GEPG_URL=
SMS_GEPG_SP_CODE=
SMS_GEPG_PUBLIC_CERT_PATH=
