# Copy to ssms/.env (never commit .env), readable by root only. ops/gen-secrets.sh does this and fills every
# secret below with new random values (database passwords are hex, so they are safe inside connection URLs).

POSTGRES_PASSWORD=change-me-superuser-only-for-migrations
SSMS_APP_DB_PASSWORD=change-me-runtime
SSMS_CONSOLE_DB_PASSWORD=change-me-console

SSMS_ENVIRONMENT=production
SSMS_JWT_SECRET=change-me-at-least-32-random-characters
# Field encryption keys "id:base64(32 bytes)"; keep old ids after rotation so old data still decrypts.
SSMS_ENC_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
SSMS_ENC_ACTIVE_KEY_ID=1
SSMS_BLIND_INDEX_KEY=REPLACE_WITH_BASE64_32_BYTES

SSMS_COOKIE_SECURE=true
SSMS_CORS_ORIGINS=["https://app.ssms.co.tz"]

SSMS_SMS_PROVIDER=beem
SSMS_BEEM_API_KEY=
SSMS_BEEM_SECRET_KEY=
SSMS_NEXTSMS_USERNAME=
SSMS_NEXTSMS_PASSWORD=
SSMS_SMS_DEFAULT_SENDER=SSMS
SSMS_SMS_WEBHOOK_SECRET=change-me-at-least-32-random-characters

# Payments (Phase 3). GePG and aggregator formats are VERIFY items; production refuses the simulator.
SSMS_GEPG_MODE=live
SSMS_GEPG_URL=
SSMS_GEPG_PRIVATE_KEY=
SSMS_GEPG_PUBLIC_KEY=
SSMS_GEPG_BILL_DAYS=30
SSMS_MOBILE_WEBHOOK_SECRET=change-me-at-least-32-random-characters
# Push prompts: only the console provider exists until an aggregator contract is signed (VERIFY).
SSMS_PUSH_PROVIDER=console

# Operations (Phase 6)
WEB_CONCURRENCY=4
SSMS_LOG_FORMAT=json
SSMS_METRICS_TOKEN=change-me-at-least-32-random-characters
SSMS_SENTRY_DSN=
SSMS_SENTRY_TRACES_SAMPLE_RATE=0
SSMS_WEBHOOK_REQUESTS_PER_MINUTE=6000

# Email (Phase 11). In production, email is off unless smtp is configured.
SSMS_EMAIL_PROVIDER=console
SSMS_EMAIL_FROM=no-reply@ssms.co.tz
SSMS_SMTP_HOST=
SSMS_SMTP_PORT=587
SSMS_SMTP_USER=
SSMS_SMTP_PASSWORD=
SSMS_SMTP_STARTTLS=true
# TLS from the first byte instead of STARTTLS (automatic on port 465):
SSMS_SMTP_IMPLICIT_TLS=false
# Only for a mail server whose certificate comes from a private CA (mount the PEM file into the containers):
SSMS_SMTP_CA_FILE=

# Deployment (Phase 13, design/18)
# HTTPS with the edge profile: the public name and the contact email for its certificate.
SSMS_DOMAIN=app.ssms.co.tz
SSMS_ACME_EMAIL=ops@ssms.co.tz
# With the edge profile, keep the plain web port off the network:
SSMS_WEB_BIND=127.0.0.1
SSMS_WEB_PORT=8080
# The edge proxy's fixed address and its network (change both together if the subnet clashes)
SSMS_EDGE_SUBNET=172.31.250.0/24
SSMS_TRUSTED_PROXY=172.31.250.10
# Virus scanning (antivirus profile). Production refuses to start without it unless explicitly allowed.
SSMS_CLAMAV_ADDRESS=clamav:3310
SSMS_ALLOW_UNSCANNED_UPLOADS=false
# Files: local (one server) or s3 (objects profile, or a cloud store: set the endpoint, region and keys).
SSMS_STORAGE_BACKEND=local
SSMS_S3_ENDPOINT_URL=http://objects:8333
SSMS_S3_BUCKET=ssms-files
SSMS_S3_REGION=us-east-1
SSMS_S3_ACCESS_KEY=change-me-access-key
SSMS_S3_SECRET_KEY=change-me-at-least-32-random-characters
# Celery worker processes
CELERY_CONCURRENCY=4

# Encrypted copies off this server (offsite profile): a bucket at another provider or in another region.
SSMS_OFFSITE_S3_ENDPOINT_URL=
SSMS_OFFSITE_S3_REGION=us-east-1
SSMS_OFFSITE_S3_BUCKET=
SSMS_OFFSITE_S3_ACCESS_KEY=
SSMS_OFFSITE_S3_SECRET_KEY=
# Keep both outside this server: without them the copies cannot be read.
SSMS_OFFSITE_PASSPHRASE=change-me-at-least-32-random-characters
SSMS_OFFSITE_SALT=change-me-at-least-32-random-characters
